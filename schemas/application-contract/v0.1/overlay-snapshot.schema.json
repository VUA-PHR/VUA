{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vua.local/application-contract/v0.1/overlay-snapshot.schema.json",
  "title": "VUA overlay.getSnapshot result (v0.1)",
  "description": "The overlay read face (proposal 017 batches 1-2): one polling query returning the task cards, the production-status card, and the download card — pure projections of the authorities (task store, plan/record document stores). No query instant and no aggregate revision by design: two unchanged queries observe the same payload (the pure-function discipline). The card word lists (task state, plan status, record status, download attempt state) are passed through verbatim from their owning frozen faces and are deliberately not re-enumerated here — the projection trims fields, it never re-speaks vocabulary. The download card (batch 2, backward-compatible optional increment: absent on snapshots written before it landed) holds the in-flight download attempts only — the presentation stance is 'rendered while items are in flight' — and carries no byte progress: progress lives on the task-event channel, and a snapshot that synthesized one is refused (the synthesized-progress discipline). Completed deliveries keep their authoritative consumer, the import page's downloads.listCompleted read face.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "taskCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "state", "correlationId"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "correlationId": { "type": "string", "minLength": 1 }
      }
    },
    "planSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "planStatus", "createdAt", "recipeId"],
      "properties": {
        "planId": { "type": "string", "minLength": 1 },
        "planStatus": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "minLength": 1 },
        "recipeId": { "type": "string", "minLength": 1 }
      }
    },
    "recordSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildId", "planId", "status", "finishedAt"],
      "properties": {
        "buildId": { "type": "string", "minLength": 1 },
        "planId": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "finishedAt": { "type": "string", "minLength": 1 }
      }
    },
    "productionCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentPlan", "latestRecord"],
      "properties": {
        "currentPlan": {
          "oneOf": [
            { "$ref": "#/$defs/planSummary" },
            { "type": "null" }
          ]
        },
        "latestRecord": {
          "oneOf": [
            { "$ref": "#/$defs/recordSummary" },
            { "type": "null" }
          ]
        }
      }
    },
    "downloadProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["downloadId", "state", "updatedAt"],
      "properties": {
        "downloadId": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "minLength": 1 }
      }
    },
    "downloadCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeDownloads"],
      "properties": {
        "activeDownloads": {
          "type": "array",
          "items": { "$ref": "#/$defs/downloadProgress" }
        }
      }
    }
  },
  "required": ["contractVersion", "tasks", "productionCard"],
  "properties": {
    "contractVersion": { "const": "0.1" },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/taskCard" }
    },
    "productionCard": { "$ref": "#/$defs/productionCard" },
    "downloadCard": { "$ref": "#/$defs/downloadCard" }
  }
}
