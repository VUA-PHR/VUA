{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vua.local/project-inspection/v0.2/snapshot.schema.json",
  "title": "VUA project inspection snapshot v0.2",
  "description": "Read-only inspection aggregate over exactly the project paths the managers registered (M6 T-A/T-B): discovery/identification, Unity version classification, the VPM manifest's declared dependencies and locked pins, VRChat SDK packages spotted among them, and the pending-mutation marker state. Documents the declared on-disk state; a failed observation is an honest warning, never an invented entry. v0.2 adds the VUA-native identity finding per project (`.vua/project.json`: absent / present(markedAt, note) / unreadable) — user rulings 2026-09-09 items 7/9/12; additive, v0.1 remains valid for consumers pinned to it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capturedAt",
    "productionTarget",
    "migrationSources",
    "projects",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "vua.project-inspection/v0.2"
    },
    "capturedAt": {
      "type": "string",
      "minLength": 1
    },
    "productionTarget": {
      "const": "2022.3.22f1"
    },
    "migrationSources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectInspection"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "editorClass": {
      "enum": [
        "production_target",
        "migration_source",
        "other_unity_version",
        "tuanjie_family"
      ]
    },
    "projectAssociation": {
      "enum": [
        "vcc_registered",
        "alcom_registered"
      ]
    },
    "mutationStatus": {
      "enum": [
        "none",
        "leftover",
        "unreadable"
      ]
    },
    "sdkSource": {
      "enum": [
        "dependencies",
        "locked"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "manifestPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "version"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "vrchatSdkFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "source",
        "version"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^com\\.vrchat\\."
        },
        "source": {
          "$ref": "#/$defs/sdkSource"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "projectInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "name",
        "pathPresent",
        "associations",
        "unityVersion",
        "unityClassification",
        "manifestPresent",
        "manifestSchemaOk",
        "dependencies",
        "locked",
        "vrchatSdks",
        "mutationStatus",
        "diagnostics",
        "vuaIdentity"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "pathPresent": {
          "type": "boolean",
          "description": "False keeps a stale registration visible (with a warning diagnostic) instead of silently dropping it."
        },
        "associations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/projectAssociation"
          }
        },
        "unityVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "unityClassification": {
          "oneOf": [
            {
              "$ref": "#/$defs/editorClass"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifestPresent": {
          "type": "boolean"
        },
        "manifestSchemaOk": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manifestPackage"
          }
        },
        "locked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manifestPackage"
          }
        },
        "vrchatSdks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vrchatSdkFinding"
          }
        },
        "mutationStatus": {
          "$ref": "#/$defs/mutationStatus"
        },
        "vuaIdentity": {
          "$ref": "#/$defs/vuaIdentityFinding"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^vua\\.(project_inspection|env_managers)\\."
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "vuaIdentityStatus": {
      "enum": [
        "absent",
        "present",
        "unreadable"
      ]
    },
    "vuaIdentityFinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "absent"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "markedAt",
            "note"
          ],
          "properties": {
            "status": {
              "const": "present"
            },
            "markedAt": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unreadable"
            }
          }
        }
      ]
    }
  }
}
