{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.local/schemas/orchestrator/envelope-v1/task-state.schema.json",
  "title": "TaskStateV1",
  "description": "The nine outward task states (orchestrator-requirements §7.2). Closed set.",
  "type": "string",
  "enum": [
    "queued",
    "preparing",
    "running",
    "waiting_for_input",
    "paused",
    "succeeded",
    "succeeded_with_warnings",
    "failed",
    "cancelled"
  ]
}
