{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.local/schemas/orchestrator/provider-frame-v0.1/handshake-response.schema.json",
  "title": "ProviderFrameV01HandshakeResponse",
  "description": "Supervised Provider frame protocol v0.1 handshake response frame (provider-process-v0.1, proposal 001). The response reuses the request frameId. The payload always carries all five fields including the mandatory downloadIngest capability bit; an in-process or supervised-process Provider implementing contract 0.1 must emit the same shape.",
  "type": "object",
  "additionalProperties": false,
  "required": ["frameVersion", "frameId", "kind", "payload"],
  "properties": {
    "frameVersion": { "const": "0.1" },
    "frameId": { "type": "string", "minLength": 1 },
    "kind": { "const": "response" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "supportedContractVersions",
        "providerBuildId",
        "providerInstanceId",
        "downloadIngest"
      ],
      "properties": {
        "contractVersion": { "const": "0.1" },
        "supportedContractVersions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "contains": { "const": "0.1" }
        },
        "providerBuildId": { "type": "string", "minLength": 1 },
        "providerInstanceId": { "type": "string", "minLength": 1 },
        "downloadIngest": { "type": "boolean" }
      }
    }
  }
}
