{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph-r.com/vua/schemas/bdl-queries/v0.1/result.schema.json",
  "title": "VUA BDL read query result v0.1",
  "description": "Results for the five read-only BDL queries (docs/protocols/bdl-queries-v0.1). Every absent fact is an honest null or empty array — never guessed, never inflated. Paths never appear: storedPath semantics stop at AMF/BDL and users do not browse the disk. entityCount/entityTypes are pinned to 0/[] in v0.1 because entity storage belongs to BDL v2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "operation": {
      "enum": [
        "catalog.list",
        "catalog.detail",
        "catalog.status",
        "warehouse.listEntries",
        "warehouse.entryDetail"
      ]
    },
    "result": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "operation": { "const": "catalog.list" } },
        "required": ["operation"]
      },
      "then": {
        "properties": { "result": { "$ref": "#/$defs/catalogListResult" } },
        "required": ["result"]
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "catalog.detail" } },
        "required": ["operation"]
      },
      "then": {
        "properties": { "result": { "$ref": "#/$defs/catalogDetailResult" } },
        "required": ["result"]
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "catalog.status" } },
        "required": ["operation"]
      },
      "then": {
        "properties": { "result": { "$ref": "#/$defs/catalogStatusResult" } },
        "required": ["result"]
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "warehouse.listEntries" } },
        "required": ["operation"]
      },
      "then": {
        "properties": { "result": { "$ref": "#/$defs/warehouseListEntriesResult" } },
        "required": ["result"]
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "warehouse.entryDetail" } },
        "required": ["operation"]
      },
      "then": {
        "properties": { "result": { "$ref": "#/$defs/warehouseEntryDetailResult" } },
        "required": ["result"]
      }
    }
  ],
  "$defs": {
    "price": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Single-price products only; null = no price information (never guessed, never converted). Variant prices live in subproducts.",
      "properties": {
        "amount": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "minLength": 1 }
      }
    },
    "productSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId", "title", "price", "imageUrl", "imageUrls",
        "availability", "entityCount", "entityTypes"
      ],
      "properties": {
        "productId": { "type": "string", "pattern": "^booth:[0-9]+$" },
        "title": { "type": ["string", "null"] },
        "price": { "$ref": "#/$defs/price" },
        "imageUrl": {
          "type": ["string", "null"],
          "description": "Always imageUrls[0] or null; carried by the vuaimg cache protocol."
        },
        "imageUrls": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Verbatim observed source URLs (BOOTH properties)."
        },
        "availability": {
          "type": ["string", "null"],
          "description": "Verbatim observed word (JSON-LD offers.availability); never normalized client- or server-side."
        },
        "entityCount": {
          "const": 0,
          "description": "Honest empty slot in v0.1: entity storage is BDL v2."
        },
        "entityTypes": {
          "const": [],
          "description": "Honest empty slot in v0.1."
        }
      }
    },
    "catalogListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "entries"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total matching entries for pagination, computed before limit/offset."
        },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/productSummary" }
        }
      }
    },
    "subproduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variationId", "name", "price", "availability"],
      "properties": {
        "variationId": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "price": { "$ref": "#/$defs/price" },
        "availability": { "type": ["string", "null"] }
      }
    },
    "productDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId", "title", "price", "imageUrl", "imageUrls",
        "availability", "entityCount", "entityTypes",
        "description", "shopName", "shopUrl", "ageRestriction", "adult",
        "videoUrls", "sourceCategory", "subproducts"
      ],
      "properties": {
        "productId": { "type": "string", "pattern": "^booth:[0-9]+$" },
        "title": { "type": ["string", "null"] },
        "price": { "$ref": "#/$defs/price" },
        "imageUrl": { "type": ["string", "null"] },
        "imageUrls": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "availability": { "type": ["string", "null"] },
        "entityCount": { "const": 0 },
        "entityTypes": { "const": [] },
        "description": { "type": ["string", "null"] },
        "shopName": { "type": ["string", "null"] },
        "shopUrl": { "type": ["string", "null"] },
        "ageRestriction": { "type": ["string", "null"] },
        "adult": {
          "type": "boolean",
          "description": "True only with the explicit BOOTH Adult badge."
        },
        "videoUrls": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceCategory": {
          "type": ["string", "null"],
          "description": "BOOTH display category, no inference."
        },
        "subproducts": {
          "type": "array",
          "items": { "$ref": "#/$defs/subproduct" }
        }
      }
    },
    "catalogDetailResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product"],
      "properties": {
        "product": { "$ref": "#/$defs/productDetail" }
      }
    },
    "catalogStatusResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health", "revision"],
      "properties": {
        "health": {
          "enum": ["unknown", "ok", "incompatible"],
          "description": "incompatible = the BDL version fence rejected the store; corrupted and stale are renderer-reserved states that v0.1 never sends."
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["catalogUpdatedSeq", "datasetRevision"],
          "properties": {
            "catalogUpdatedSeq": {
              "type": ["integer", "null"],
              "minimum": 0,
              "description": "null until the observation-pipeline bookkeeping counter exists."
            },
            "datasetRevision": {
              "type": "string",
              "minLength": 1,
              "description": "v0.1 = the BDL format_version."
            }
          }
        }
      }
    },
    "warehouseArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "artifactSha256", "state", "sizeBytes"],
      "properties": {
        "relativePath": { "type": "string", "minLength": 1 },
        "artifactSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "state": {
          "enum": ["pending", "clean", "quarantined"],
          "description": "Wire three-state mapped from the storage lifecycle: pending ← untrusted|inspected, clean ← admitted, quarantined ← rejected."
        },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "warehouseListEntriesResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "warehouseItemId", "folderName", "displayName", "kind",
              "createdAt", "artifacts"
            ],
            "properties": {
              "warehouseItemId": { "type": "string", "minLength": 1 },
              "folderName": { "type": "string", "minLength": 1 },
              "displayName": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "createdAt": { "type": "string", "minLength": 1 },
              "artifacts": {
                "type": "array",
                "items": { "$ref": "#/$defs/warehouseArtifactRef" }
              }
            }
          }
        }
      }
    },
    "warehouseArtifactFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath", "artifactSha256", "state", "sizeBytes",
        "suggestedFileName", "inspectedAt", "rejectionReason",
        "sourceCorrelated", "mappedProductIds"
      ],
      "properties": {
        "relativePath": { "type": "string", "minLength": 1 },
        "artifactSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "state": { "enum": ["pending", "clean", "quarantined"] },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "suggestedFileName": { "type": ["string", "null"] },
        "inspectedAt": {
          "type": ["string", "null"],
          "description": "Mechanical verdict time; null while pending."
        },
        "rejectionReason": {
          "type": ["string", "null"],
          "description": "Honest verdict text; non-null only when quarantined."
        },
        "sourceCorrelated": {
          "type": "boolean",
          "description": "Existence of an artifact_mappings row."
        },
        "mappedProductIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^booth:[0-9]+$" }
        }
      }
    },
    "warehouseEntryDetailResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "warehouseItemId", "folderName", "displayName", "kind",
            "createdAt", "artifacts"
          ],
          "properties": {
            "warehouseItemId": { "type": "string", "minLength": 1 },
            "folderName": { "type": "string", "minLength": 1 },
            "displayName": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "createdAt": { "type": "string", "minLength": 1 },
            "artifacts": {
              "type": "array",
              "items": { "$ref": "#/$defs/warehouseArtifactFact" }
            }
          }
        }
      }
    }
  }
}
