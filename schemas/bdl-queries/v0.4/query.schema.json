{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph-r.com/vua/schemas/bdl-queries/v0.4/query.schema.json",
  "title": "VUA BDL read query v0.4",
  "description": "Read-only catalog, warehouse and download queries served by AMF from the local BDL (docs/protocols/bdl-queries-v0.4). AMF decides what is served; the renderer never touches BDL. The transport envelope belongs to the application contract — this schema freezes the operation vocabulary, the query closed set and the params. v0.4 adds downloads.listCompleted: the adoptable-completed-downloads list whose membership predicate is the SAME server-side fact the warehouse.importDownloads adoption guard consumes (event fold at a completed delivery with the staging file physically present at the reported size) — the list is the guard's mirror, so what the UI shows is adoptable. Results never carry paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "params"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.4"
    },
    "operation": {
      "enum": [
        "catalog.list",
        "catalog.detail",
        "catalog.status",
        "warehouse.listEntries",
        "warehouse.entryDetail",
        "downloads.listCompleted"
      ]
    },
    "params": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "catalog.list"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/catalogListParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "catalog.detail"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/catalogDetailParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "catalog.status"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/emptyParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "warehouse.listEntries"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/emptyParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "warehouse.entryDetail"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/warehouseEntryDetailParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "downloads.listCompleted"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/emptyParams"
          }
        }
      }
    }
  ],
  "$defs": {
    "emptyParams": {
      "type": "object",
      "additionalProperties": false
    },
    "catalogListParams": {
      "type": "object",
      "additionalProperties": false,
      "description": "The v0.2 query closed set. entityType / relationKind are deliberately absent — entity and relation storage belongs to BDL v2; their presence is a contract error, never a silently empty answer. Entries are ordered by productId ascending (identity-derived, deterministic pagination).",
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Case-insensitive substring over title and productId; null or omitted = no filtering."
        },
        "availabilityStatus": {
          "enum": [
            "available",
            "unavailable",
            "unknown",
            null
          ],
          "description": "Exact match against the derived stable enum (never the raw word); null or omitted = no filtering."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50,
          "description": "Page size for the card wall."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "catalogDetailParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^booth:[0-9]+$",
          "description": "Namespaced corpus identity."
        }
      }
    },
    "warehouseEntryDetailParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warehouseItemId"
      ],
      "properties": {
        "warehouseItemId": {
          "type": "string",
          "minLength": 1,
          "description": "VUA-generated local identity, stable and never derived from display names."
        }
      }
    }
  }
}
