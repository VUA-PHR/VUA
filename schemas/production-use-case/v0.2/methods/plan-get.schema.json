{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vua.local/production-use-case/v0.2/methods/plan-get.schema.json",
  "title": "VUA production.plan-get (v0.2)",
  "description": "Reads one approved-plan document (011 section 4 shape; full field validation lives in schemas/recipe/v0.3/approved-plan.schema.json).",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "planId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "planDocument": {
      "type": "object"
    },
    "planStatus": {
      "enum": [
        "draft",
        "approved",
        "superseded"
      ]
    },
    "plan-getRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId"
      ],
      "properties": {
        "planId": {
          "$ref": "#/$defs/planId"
        }
      }
    },
    "plan-getResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "planStatus",
        "planDocument",
        "schemaVersion"
      ],
      "properties": {
        "planId": {
          "$ref": "#/$defs/planId"
        },
        "planStatus": {
          "$ref": "#/$defs/planStatus"
        },
        "planDocument": {
          "$ref": "#/$defs/planDocument"
        },
        "schemaVersion": {
          "const": "0.2"
        }
      }
    }
  }
}