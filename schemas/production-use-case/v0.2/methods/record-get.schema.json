{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vua.local/production-use-case/v0.2/methods/record-get.schema.json",
  "title": "VUA production.record-get (v0.2)",
  "description": "Reads one Build Record v0.3 document (full validation in schemas/recipe/v0.3/build-record.schema.json).",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "buildId": {
      "type": "string",
      "minLength": 1
    },
    "recordDocument": {
      "type": "object"
    },
    "record-getRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildId"
      ],
      "properties": {
        "buildId": {
          "$ref": "#/$defs/buildId"
        }
      }
    },
    "record-getResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildId",
        "recordDocument",
        "schemaVersion"
      ],
      "properties": {
        "buildId": {
          "$ref": "#/$defs/buildId"
        },
        "recordDocument": {
          "$ref": "#/$defs/recordDocument"
        },
        "schemaVersion": {
          "const": "0.2"
        }
      }
    }
  }
}