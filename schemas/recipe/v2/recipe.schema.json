{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.dev/schemas/recipe/v2/recipe.schema.json",
  "title": "VUA Recipe v2",
  "description": "Portable desired-state description and optional public resolution lock for an Avatar composition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recipeId",
    "revision",
    "title",
    "createdAt",
    "updatedAt",
    "environment",
    "target",
    "assets",
    "instances",
    "relations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "recipeId": {
      "$ref": "#/$defs/uuidV7"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/instance"
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "wardrobeGroups": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/wardrobeGroup"
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "locked": {
      "$ref": "#/$defs/locked"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unityVersionConstraint"
      ],
      "properties": {
        "unityVersionConstraint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/capabilityRequirement"
          }
        }
      }
    },
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platforms",
        "avatarInstanceId"
      ],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "android"
            ]
          }
        },
        "avatarInstanceId": {
          "$ref": "#/$defs/localId"
        },
        "performanceTarget": {
          "enum": [
            "auto",
            "excellent",
            "good",
            "medium",
            "poor"
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "role": {
          "enum": [
            "avatar_base",
            "avatar_profile",
            "body",
            "outfit",
            "hair",
            "accessory",
            "prop",
            "expression_pack",
            "animation_pack",
            "shader",
            "texture_pack",
            "material_pack",
            "tool_dependency",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "entityRef": {
          "$ref": "#/$defs/entityRef"
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "selection": {
          "$ref": "#/$defs/publicSelection"
        },
        "requiresAssetIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localId"
          }
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "anyOf": [
        {
          "required": [
            "entityRef"
          ],
          "properties": {
            "entityRef": true
          }
        },
        {
          "required": [
            "sourceRef"
          ],
          "properties": {
            "sourceRef": true
          }
        }
      ]
    },
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId"
      ],
      "properties": {
        "entityId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "productId"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "publicSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "releaseLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "distributionLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "minProperties": 1
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "assetId",
        "entrypoint"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "assetId": {
          "$ref": "#/$defs/localId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "entrypoint": {
          "$ref": "#/$defs/entrypointSelector"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "entrypointSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectorId",
        "kind"
      ],
      "properties": {
        "selectorId": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "enum": [
            "avatar_prefab",
            "modular_avatar_prefab",
            "prefab",
            "asset"
          ]
        },
        "catalogEntryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nameHint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "anyOf": [
        {
          "required": [
            "catalogEntryId"
          ],
          "properties": {
            "catalogEntryId": true
          }
        },
        {
          "required": [
            "nameHint"
          ],
          "properties": {
            "nameHint": true
          }
        }
      ]
    },
    "relation": {
      "oneOf": [
        {
          "$ref": "#/$defs/installModularAsset"
        },
        {
          "$ref": "#/$defs/attachToBone"
        },
        {
          "$ref": "#/$defs/excludeObject"
        },
        {
          "$ref": "#/$defs/setObjectActive"
        }
      ]
    },
    "installModularAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "assetInstanceId",
        "avatarInstanceId",
        "mode"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "const": "install_modular_asset"
        },
        "assetInstanceId": {
          "$ref": "#/$defs/localId"
        },
        "avatarInstanceId": {
          "$ref": "#/$defs/localId"
        },
        "mode": {
          "enum": [
            "consume_authored_setup",
            "generate_setup"
          ]
        }
      }
    },
    "attachToBone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "assetInstanceId",
        "avatarInstanceId",
        "bone",
        "localTransform"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "const": "attach_to_bone"
        },
        "assetInstanceId": {
          "$ref": "#/$defs/localId"
        },
        "avatarInstanceId": {
          "$ref": "#/$defs/localId"
        },
        "bone": {
          "$ref": "#/$defs/humanoidBone"
        },
        "localTransform": {
          "$ref": "#/$defs/transform"
        }
      }
    },
    "excludeObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "targetInstanceId",
        "selector"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "const": "exclude_object"
        },
        "targetInstanceId": {
          "$ref": "#/$defs/localId"
        },
        "selector": {
          "$ref": "#/$defs/objectSelector"
        }
      }
    },
    "setObjectActive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "targetInstanceId",
        "selector",
        "active"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "const": "set_object_active"
        },
        "targetInstanceId": {
          "$ref": "#/$defs/localId"
        },
        "selector": {
          "$ref": "#/$defs/objectSelector"
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "objectSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectorId"
      ],
      "properties": {
        "selectorId": {
          "$ref": "#/$defs/localId"
        },
        "catalogEntryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pathHint": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "catalogEntryId"
          ],
          "properties": {
            "catalogEntryId": true
          }
        },
        {
          "required": [
            "pathHint"
          ],
          "properties": {
            "pathHint": true
          }
        }
      ]
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "rotation",
        "scale"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "rotation": {
          "$ref": "#/$defs/quaternion"
        },
        "scale": {
          "$ref": "#/$defs/vector3"
        }
      }
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "quaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number"
        }
      }
    },
    "humanoidBone": {
      "enum": [
        "hips",
        "spine",
        "chest",
        "upper_chest",
        "neck",
        "head",
        "left_eye",
        "right_eye",
        "jaw",
        "left_shoulder",
        "left_upper_arm",
        "left_lower_arm",
        "left_hand",
        "right_shoulder",
        "right_upper_arm",
        "right_lower_arm",
        "right_hand",
        "left_upper_leg",
        "left_lower_leg",
        "left_foot",
        "left_toes",
        "right_upper_leg",
        "right_lower_leg",
        "right_foot",
        "right_toes"
      ]
    },
    "wardrobeGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "memberInstanceIds",
        "selectionMode"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "memberInstanceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localId"
          }
        },
        "selectionMode": {
          "enum": [
            "exactly_one",
            "zero_or_one",
            "any"
          ]
        },
        "defaultInstanceIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localId"
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "versionConstraint"
      ],
      "properties": {
        "packageId": {
          "$ref": "#/$defs/packageId"
        },
        "versionConstraint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "requestedByAssetIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localId"
          }
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "packageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "locked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockVersion",
        "recipeRevision",
        "generatedAt",
        "status",
        "unity",
        "packages",
        "assets"
      ],
      "properties": {
        "lockVersion": {
          "const": 1
        },
        "recipeRevision": {
          "type": "integer",
          "minimum": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "unity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^20[0-9]{2}\\.[0-9]+\\.[0-9]+[abfp][0-9]+$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{12}$"
            }
          }
        },
        "packages": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/lockedPackage"
          }
        },
        "assets": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/lockedAsset"
          }
        }
      }
    },
    "lockedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "version",
        "depth",
        "source"
      ],
      "properties": {
        "packageId": {
          "$ref": "#/$defs/packageId"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/lockedPackageSource"
        }
      }
    },
    "lockedPackageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "restorable"
      ],
      "properties": {
        "kind": {
          "enum": [
            "vpm",
            "unity_registry",
            "builtin",
            "embedded",
            "local"
          ]
        },
        "restorable": {
          "type": "boolean"
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "repositoryRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "artifactDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lockedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "resolution"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/localId"
        },
        "resolution": {
          "enum": [
            "exact",
            "label_only",
            "unverifiable"
          ]
        },
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "releaseLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "distributionLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": true
    }
  }
}
