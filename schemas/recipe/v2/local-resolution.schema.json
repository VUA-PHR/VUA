{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.dev/schemas/recipe/v2/local-resolution.schema.json",
  "title": "VUA Recipe Local Resolution v1",
  "description": "Private machine-local bindings from Recipe selectors to Warehouse and Unity objects. This document is never shareable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recipeId",
    "recipeRevision",
    "environmentId",
    "resolvedAt",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recipeId": {
      "$ref": "#/$defs/uuidV7"
    },
    "recipeRevision": {
      "type": "integer",
      "minimum": 1
    },
    "environmentId": {
      "$ref": "#/$defs/uuidV7"
    },
    "resolvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "assets": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/assetResolution"
      }
    }
  },
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "unityGuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assetResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "warehouseAssetId",
        "artifactId",
        "artifactFingerprint",
        "entrypoints",
        "objectBindings"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/localId"
        },
        "warehouseAssetId": {
          "$ref": "#/$defs/uuidV7"
        },
        "artifactId": {
          "$ref": "#/$defs/uuidV7"
        },
        "artifactFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "entrypoints": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/entrypointBinding"
          }
        },
        "objectBindings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/objectBinding"
          }
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256-archive-v1",
            "sha256-tree-v1"
          ]
        },
        "value": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "entrypointBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectorId",
        "unityAssetGuid"
      ],
      "properties": {
        "selectorId": {
          "$ref": "#/$defs/localId"
        },
        "unityAssetGuid": {
          "$ref": "#/$defs/unityGuid"
        },
        "localFileId": {
          "type": "integer"
        }
      }
    },
    "objectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectorId",
        "entrypointSelectorId",
        "localFileId"
      ],
      "properties": {
        "selectorId": {
          "$ref": "#/$defs/localId"
        },
        "entrypointSelectorId": {
          "$ref": "#/$defs/localId"
        },
        "localFileId": {
          "type": "integer"
        },
        "hierarchyPathHint": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  }
}
