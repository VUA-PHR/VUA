{
  "name": "request-plan.valid",
  "steps": [
    {
      "method": "production.startInspection",
      "params": {
        "sourceFolder": "$sourceFolder",
        "projectRoot": "$projectRoot",
        "artifactOutputRoot": "$artifactOutputRoot",
        "projectId": "$projectId"
      },
      "expect": {
        "ok": true
      }
    },
    {
      "method": "production.requestPlan",
      "params": {
        "inspectionId": "$inspectionId",
        "mode": "direct_unity_package"
      },
      "expect": {
        "ok": true,
        "checks": {
          "planId": {
            "startsWith": "plan-"
          }
        }
      }
    }
  ]
}
