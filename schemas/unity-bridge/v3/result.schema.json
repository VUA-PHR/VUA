{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph-r.com/vua/schemas/unity-bridge/v3/result.schema.json",
  "title": "VUA Unity bridge result v3",
  "description": "Versioned result returned by the VUA Unity middleware to AMF Production. v3 is a frozen superset of v2 (same-face upgrade, v1->v2 precedent): all v2 operations, fields, and receipt semantics are preserved unchanged. v3 recognizes the three M7 inspection read operations (proposal 016 hard precondition 1) and adds exactly one data field: instanceGlobalObjectId, legalizing the proposal-011 success-criterion receipt field (reserved in C# since aa2a9da, previously absent from the frozen v2 schema — known drift declared in proposal 016). Inspection findings travel in the existing diagnostics array as typed dot-namespaced codes with the info|warning|error severity vocabulary — the same shape the inspection-evidence checks[] array transcribes. Read-only inspection receipts report succeeded when the check ran (findings are diagnostics, not failures); rejected is reserved for unresolvable targets (e.g. a stale avatar reference), mirroring the v1 check-operation precedent. Honesty rules inherited unchanged: a dry-run receipt never poses as a real run, and inspection findings never pose as official VRChat ratings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "status", "changedPaths", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "commandId": { "type": "string", "minLength": 1 },
    "operation": {
      "enum": [
        "inspect_project",
        "import_unity_package",
        "materialize_extracted_package",
        "create_local_vpm_package",
        "validate_asset_paths",
        "identify_assets",
        "install_outfit",
        "create_toggle",
        "validate_avatar",
        "analyze_performance",
        "execute_production_job",
        "restore_project",
        "inspect_avatar_references",
        "inspect_lighting",
        "inspect_upload_readiness"
      ]
    },
    "status": { "enum": ["succeeded", "failed", "rejected"] },
    "changedPaths": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning", "error"] },
          "message": { "type": "string" }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectFingerprint": { "type": "string" },
        "projectFingerprintBefore": { "type": "string" },
        "avatarName": { "type": "string" },
        "outfitName": { "type": "string" },
        "basis": { "enum": ["", "local_estimate"] },
        "triangles": { "type": "integer", "minimum": 0 },
        "materialSlots": { "type": "integer", "minimum": 0 },
        "skinnedMeshRenderers": { "type": "integer", "minimum": 0 },
        "bones": { "type": "integer", "minimum": 0 },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "importedAssetPaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "packageRoot": { "type": "string" },
        "loadedAssetPaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "commandFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "replayed": { "type": "boolean" },
        "dryRun": { "type": "boolean" },
        "planHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "status"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pending", "executed", "failed", "skipped"] },
              "warning": { "type": "string" },
              "resolvedSource": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sourceKind", "artifactSha256"],
                "properties": {
                  "sourceKind": { "enum": ["original", "generated_vpm"] },
                  "artifactSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "warehouseItemId": { "type": ["string", "null"], "minLength": 1 }
                }
              }
            }
          }
        },
        "snapshotId": { "type": "string", "minLength": 1 },
        "restoredFrom": { "type": "string", "minLength": 1 },
        "instanceGlobalObjectId": {
          "description": "GlobalObjectId of the instantiated instance root produced by an install_modular_asset job step (proposal 011 success criterion — the receipt carries the instance identity; reserved in C# since aa2a9da, wired and legalized in v3).",
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": { "const": "execute_production_job" },
          "status": { "enum": ["succeeded", "failed"] }
        },
        "required": ["operation", "status"]
      },
      "then": {
        "properties": {
          "data": { "required": ["dryRun", "planHash", "steps"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": { "const": "execute_production_job" },
          "status": { "enum": ["succeeded", "failed"] },
          "data": {
            "properties": { "dryRun": { "const": false } },
            "required": ["dryRun"]
          }
        },
        "required": ["operation", "status", "data"]
      },
      "then": {
        "properties": {
          "data": { "required": ["snapshotId", "projectFingerprintBefore"] }
        }
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "restore_project" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "data": { "required": ["restoredFrom"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "inspect_avatar_references",
              "inspect_lighting",
              "inspect_upload_readiness"
            ]
          },
          "status": { "const": "succeeded" }
        },
        "required": ["operation", "status"]
      },
      "then": {
        "properties": {
          "diagnostics": { "minItems": 1 },
          "changedPaths": { "maxItems": 0 }
        }
      }
    }
  ]
}
