{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph-r.com/vua/schemas/unity-bridge/v4/result.schema.json",
  "title": "VUA Unity bridge result v4",
  "description": "Versioned result returned by the VUA Unity middleware to AMF Production. v4 is a frozen superset of v3 (same-face upgrade, v1->v2->v3 precedent): all v3 operations, fields, and receipt semantics are preserved unchanged. v4 recognizes exactly one new operation, build_preview (slice/production-nav-bake-preview, user ruling 2026-09-20). build_preview receipts reuse the existing data face without new fields: statistics travel in data.triangles/materialSlots/skinnedMeshRenderers/bones with data.basis local_estimate (the analyze_performance caliber, never an official VRChat rating), data.avatarName names the resolved avatar, and the artifact directory (.vua/bridge/preview/<commandId>/) is recorded in changedPaths. A dry-run receipt reports succeeded with the statistics and no images; diagnostics carry preview.dry_run / preview.baked / preview.no_avatar / preview.bake_failed typed codes. On the C# side the build_preview receipt echoes the command protocol version (the execute_production_job receipt-version precedent), so v4 receipts are labeled 4. Honesty rules inherited unchanged: a dry-run receipt never poses as a real run, statistics never pose as official ratings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "status", "changedPaths", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "commandId": { "type": "string", "minLength": 1 },
    "operation": {
      "enum": [
        "inspect_project",
        "import_unity_package",
        "materialize_extracted_package",
        "create_local_vpm_package",
        "validate_asset_paths",
        "identify_assets",
        "install_outfit",
        "create_toggle",
        "validate_avatar",
        "analyze_performance",
        "execute_production_job",
        "restore_project",
        "inspect_avatar_references",
        "inspect_lighting",
        "inspect_upload_readiness",
        "build_preview"
      ]
    },
    "status": { "enum": ["succeeded", "failed", "rejected"] },
    "changedPaths": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning", "error"] },
          "message": { "type": "string" }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectFingerprint": { "type": "string" },
        "projectFingerprintBefore": { "type": "string" },
        "avatarName": { "type": "string" },
        "outfitName": { "type": "string" },
        "basis": { "enum": ["", "local_estimate"] },
        "triangles": { "type": "integer", "minimum": 0 },
        "materialSlots": { "type": "integer", "minimum": 0 },
        "skinnedMeshRenderers": { "type": "integer", "minimum": 0 },
        "bones": { "type": "integer", "minimum": 0 },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "importedAssetPaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "packageRoot": { "type": "string" },
        "loadedAssetPaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "commandFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "replayed": { "type": "boolean" },
        "dryRun": { "type": "boolean" },
        "planHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "status"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pending", "executed", "failed", "skipped"] },
              "warning": { "type": "string" },
              "resolvedSource": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sourceKind", "artifactSha256"],
                "properties": {
                  "sourceKind": { "enum": ["original", "generated_vpm"] },
                  "artifactSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "warehouseItemId": { "type": ["string", "null"], "minLength": 1 }
                }
              }
            }
          }
        },
        "snapshotId": { "type": "string", "minLength": 1 },
        "restoredFrom": { "type": "string", "minLength": 1 },
        "instanceGlobalObjectId": {
          "description": "GlobalObjectId of the instantiated instance root produced by an install_modular_asset job step (proposal 011 success criterion — the receipt carries the instance identity; reserved in C# since aa2a9da, wired and legalized in v3).",
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": { "const": "execute_production_job" },
          "status": { "enum": ["succeeded", "failed"] }
        },
        "required": ["operation", "status"]
      },
      "then": {
        "properties": {
          "data": { "required": ["dryRun", "planHash", "steps"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": { "const": "execute_production_job" },
          "status": { "enum": ["succeeded", "failed"] },
          "data": {
            "properties": { "dryRun": { "const": false } },
            "required": ["dryRun"]
          }
        },
        "required": ["operation", "status", "data"]
      },
      "then": {
        "properties": {
          "data": { "required": ["snapshotId", "projectFingerprintBefore"] }
        }
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "restore_project" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "data": { "required": ["restoredFrom"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "inspect_avatar_references",
              "inspect_lighting",
              "inspect_upload_readiness"
            ]
          },
          "status": { "const": "succeeded" }
        },
        "required": ["operation", "status"]
      },
      "then": {
        "properties": {
          "diagnostics": { "minItems": 1 },
          "changedPaths": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": { "const": "build_preview" },
          "status": { "const": "succeeded" }
        },
        "required": ["operation", "status"]
      },
      "then": {
        "properties": {
          "diagnostics": { "minItems": 1 }
        }
      }
    }
  ]
}
