{
  "name": "vua-workspace",
  "private": true,
  "version": "0.5.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "collab:brief": "node scripts/collab-brief.mjs",
    "dev:desktop": "pnpm --filter @vua/desktop dev",
    "start:desktop": "pnpm --filter @vua/desktop start"
  }
}
